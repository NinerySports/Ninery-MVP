{
  "name": "ninery",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "prisma": "corepack pnpm --filter @ninery/database exec prisma",
    "seed": "corepack pnpm --filter @ninery/database seed",
    "seed:clear": "corepack pnpm --filter @ninery/database seed:clear",
    "seed:demo": "corepack pnpm --filter @ninery/database seed:demo",
    "seed:reference": "corepack pnpm --filter @ninery/database seed:reference",
    "seed:equipment": "corepack pnpm --filter @ninery/database seed:equipment",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
