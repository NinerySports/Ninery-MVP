{
  "name": "ninery",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @ninery/web dev",
    "dev:api": "pnpm --filter @ninery/api dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "node --test \"scripts/*.test.mjs\" && turbo run test",
    "env:check": "node scripts/env-check.mjs",
    "doctor": "node scripts/doctor.mjs",
    "prisma": "corepack pnpm --filter @ninery/database exec prisma",
    "db:validate": "pnpm --filter @ninery/database prisma:validate",
    "db:generate": "pnpm --filter @ninery/database prisma:generate",
    "db:push": "pnpm --filter @ninery/database prisma:db:push",
    "db:seed": "pnpm --filter @ninery/database seed",
    "db:studio": "pnpm --filter @ninery/database prisma:studio",
    "db:setup": "pnpm db:validate && pnpm db:generate && pnpm db:push && pnpm db:seed",
    "seed": "corepack pnpm --filter @ninery/database seed",
    "seed:clear": "corepack pnpm --filter @ninery/database seed:clear",
    "seed:demo": "corepack pnpm --filter @ninery/database seed:demo",
    "seed:reference": "corepack pnpm --filter @ninery/database seed:reference",
    "seed:equipment": "corepack pnpm --filter @ninery/database seed:equipment",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
