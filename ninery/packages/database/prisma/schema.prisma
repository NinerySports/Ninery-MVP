generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FamilyMemberRole {
  owner
  guardian
  viewer
}

enum Sport {
  baseball
  softball
}

enum PlayerStatus {
  active
  archived
}

enum Handedness {
  left
  right
}

enum BattingSide {
  left
  right
  switch
}

enum CompetitionLevel {
  recreational
  school
  travel
  elite
  unknown
}

enum EquipmentCategory {
  bat
  glove
  cleat
  helmet
  catcher_gear
}

enum EquipmentStatus {
  active
  coming_soon
  legacy
  archived
}

enum EquipmentCertification {
  USA
  USSSA
  BBCOR
  none
  unknown
}

enum CertificationLevel {
  bronze
  silver
  gold
  platinum
}

enum DNAProfileStatus {
  draft
  active
  archived
}

enum EvidenceLevel {
  internal_review
  manufacturer_specs
  field_testing
  validated_outcomes
}

enum ConfidenceLevel {
  low
  medium
  high
  validated
}

enum EvidenceType {
  manufacturer_specs
  internal_review
  third_party_review
  field_testing
  user_feedback
  performance_data
  validated_outcomes
}

enum EvidenceReliability {
  low
  medium
  high
  verified
}

enum EvidenceStatus {
  collected
  in_review
  approved
  rejected
  archived
}

enum EquipmentFitType {
  player_stage
  swing_profile
  opportunity_profile
  preference
  transition
}

enum ComparisonConfidence {
  low
  medium
  high
  validated
}

enum EquipmentDNATargetLevel {
  equipment
  variant
}

enum EquipmentDNAEvidenceSourceType {
  manufacturer_specification
  objective_measurement
  structured_expert_evaluation
  player_feedback
  parent_feedback
  coach_feedback
  field_observation
  historical_outcome
  internal_derived
  other
}

enum EquipmentDNAEvidenceRecordStatus {
  active
  superseded
  disputed
  withdrawn
}

enum EquipmentEvaluationMethod {
  direct_specification
  instrument_measurement
  standardized_rubric
  multi_evaluator_consensus
  structured_feedback
  derived_mapping
  manual_review
}

enum EquipmentAttributeConfidence {
  validated
  high
  moderate
  estimated
}

enum EquipmentDNAAttributeEvaluationStatus {
  draft
  active
  superseded
  rejected
}

enum EquipmentDNAEvaluatorType {
  system
  staff
  expert
  external
}

enum PlayerDNAProfileStatus {
  generated
  archived
}

enum PreferredSwingFeel {
  light
  balanced
  slightly_end_loaded
  end_loaded
  unknown
}

enum DevelopmentStage {
  foundation
  developing
  competitive
  performance
  advanced
}

enum PrimaryHittingGoal {
  improve_contact
  improve_power
  improve_bat_control
  increase_swing_speed
  build_confidence
  prepare_for_transition
  maintain_current_fit
  unknown
}

enum GrowthStatus {
  stable
  moderate_growth
  rapid_growth
  insufficient_data
}

enum ProfileConfidenceLevel {
  low
  medium
  high
  validated
}

enum CurrentEquipmentFamiliarityLevel {
  new_or_unfamiliar
  limited_familiarity
  developing_familiarity
  established_familiarity
  highly_established_familiarity
  unknown
}

enum CurrentEquipmentFamiliarityConfidence {
  estimated
  moderate
  high
}

enum CurrentEquipmentFamiliaritySource {
  player
  parent_or_guardian
  coach
  internal_staff
  system_history
  combined
}

enum TransitionShadowStudyStatus {
  draft
  prediction_captured
  observation_active
  observation_complete
  cancelled
  invalidated
}

enum TransitionObservationCheckpoint {
  first_use
  early_sessions
  acclimation_period
  custom
}

enum TransitionObservationSource {
  player
  parent_or_guardian
  coach
  internal_staff
  combined
}

enum TransitionObservationConfidence {
  low
  moderate
  high
}

enum PlayerTimelineEventType {
  player_created
  profile_updated
  growth_measurement_added
  equipment_added
  batmatch_started
  batmatch_completed
  player_dna_generated
  recommendation_generated
  decision_book_created
  outcome_recorded
  milestone_added
}

enum PlatformEventType {
  user_registered
  family_created
  player_created
  player_profile_updated
  growth_measurement_added
  equipment_created
  equipment_dna_published
  batmatch_started
  batmatch_answer_submitted
  batmatch_completed
  player_dna_generated
  recommendation_generated
  decision_book_created
  decision_book_shared
  ai_response_generated
  outcome_recorded
}

enum ReferenceDataType {
  manufacturer
  position
  competition_level
  certification
  equipment_category
  development_stage
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  passwordHash  String
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdFamilies Family[]       @relation("FamilyCreator")
  memberships     FamilyMember[]

  @@map("users")
}

model Family {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdByUser User           @relation("FamilyCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  members       FamilyMember[]
  players       Player[]

  @@index([createdByUserId])
  @@map("families")
}

model FamilyMember {
  id        String           @id @default(uuid()) @db.Uuid
  familyId  String           @db.Uuid
  userId    String           @db.Uuid
  role      FamilyMemberRole
  createdAt DateTime         @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@index([familyId])
  @@index([userId])
  @@map("family_members")
}

model Player {
  id             String       @id @default(uuid()) @db.Uuid
  familyId       String       @db.Uuid
  firstName      String
  lastName       String
  nickname       String?
  dateOfBirth    DateTime?
  graduationYear Int?
  sport          Sport
  photoUrl       String?
  status         PlayerStatus @default(active)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  family                      Family                              @relation(fields: [familyId], references: [id], onDelete: Cascade)
  profile                     PlayerProfile?
  growthMeasurements          GrowthMeasurement[]
  batMatchSessions            BatMatchSession[]
  decisionSignals             DecisionSignal[]
  recommendations             Recommendation[]
  opportunityProfiles         PlayerOpportunityProfile[]
  decisionBooks               DecisionBook[]
  timelineEvents              PlayerTimelineEvent[]
  dnaProfiles                 PlayerDNAProfile[]
  equipmentFamiliarityRecords CurrentEquipmentFamiliarityRecord[]
  transitionShadowStudies     TransitionExtendedShadowStudy[]

  @@index([familyId])
  @@index([graduationYear])
  @@index([status])
  @@map("players")
}

model PlayerProfile {
  id                String           @id @default(uuid()) @db.Uuid
  playerId          String           @unique @db.Uuid
  throwingHand      Handedness?
  battingSide       BattingSide?
  primaryPosition   String?
  secondaryPosition String?
  competitionLevel  CompetitionLevel @default(unknown)
  teamName          String?
  practiceFrequency String?
  experienceYears   Int?
  updatedAt         DateTime         @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@map("player_profiles")
}

model GrowthMeasurement {
  id         String   @id @default(uuid()) @db.Uuid
  playerId   String   @db.Uuid
  heightCm   Decimal? @db.Decimal(5, 2)
  weightKg   Decimal? @db.Decimal(5, 2)
  measuredAt DateTime
  source     String?
  confidence Decimal? @db.Decimal(5, 4)
  createdAt  DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([measuredAt])
  @@map("growth_measurements")
}

model Equipment {
  id             String                 @id @default(uuid()) @db.Uuid
  manufacturer   String
  model          String
  modelYear      Int?
  category       EquipmentCategory
  certification  EquipmentCertification @default(unknown)
  material       String?
  construction   String?
  barrelDiameter Decimal?               @db.Decimal(4, 2)
  status         EquipmentStatus        @default(active)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  variants                        EquipmentVariant[]
  dnaProfiles                     EquipmentDNAProfile[]
  specifications                  EquipmentSpecification[]
  evidence                        EquipmentEvidence[]
  dnaEvidenceRecords              EquipmentDNAEvidenceRecord[]
  dnaAttributeEvaluations         EquipmentDNAAttributeEvaluation[]
  fitProfiles                     EquipmentFitProfile[]
  personalities                   EquipmentPersonality[]
  sourceComparisons               EquipmentComparison[]               @relation("SourceEquipmentComparison")
  targetComparisons               EquipmentComparison[]               @relation("TargetEquipmentComparison")
  recommendationItems             RecommendationItem[]
  familiarityRecords              CurrentEquipmentFamiliarityRecord[]
  currentTransitionShadowStudies  TransitionExtendedShadowStudy[]     @relation("CurrentTransitionShadowEquipment")
  proposedTransitionShadowStudies TransitionExtendedShadowStudy[]     @relation("ProposedTransitionShadowEquipment")
  externalEvidenceIdentities      ExternalEvidenceIdentityAssertion[]

  @@index([manufacturer])
  @@index([model])
  @@index([modelYear])
  @@index([category])
  @@index([certification])
  @@index([status])
  @@map("equipment")
}

model EquipmentVariant {
  id           String   @id @default(uuid()) @db.Uuid
  equipmentId  String   @db.Uuid
  lengthInches Decimal? @db.Decimal(4, 1)
  weightOunces Decimal? @db.Decimal(4, 1)
  dropWeight   Int?
  msrp         Decimal? @db.Decimal(8, 2)
  sku          String?  @unique
  createdAt    DateTime @default(now())

  equipment                       Equipment                           @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  recommendationItems             RecommendationItem[]
  dnaEvidenceRecords              EquipmentDNAEvidenceRecord[]
  dnaAttributeEvaluations         EquipmentDNAAttributeEvaluation[]
  familiarityRecords              CurrentEquipmentFamiliarityRecord[]
  currentTransitionShadowStudies  TransitionExtendedShadowStudy[]     @relation("CurrentTransitionShadowVariant")
  proposedTransitionShadowStudies TransitionExtendedShadowStudy[]     @relation("ProposedTransitionShadowVariant")
  externalEvidenceIdentities      ExternalEvidenceIdentityAssertion[]

  @@index([equipmentId])
  @@map("equipment_variants")
}

model EquipmentCharacteristic {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  category    String
  description String?
  version     Int      @default(1)
  createdAt   DateTime @default(now())

  scores EquipmentDNAScore[]

  @@map("equipment_characteristics")
}

model EquipmentDNAProfile {
  id                 String             @id @default(uuid()) @db.Uuid
  equipmentId        String             @db.Uuid
  version            Int                @default(1)
  certificationLevel CertificationLevel
  confidenceScore    ConfidenceLevel    @default(medium)
  status             DNAProfileStatus   @default(draft)
  createdAt          DateTime           @default(now())
  publishedAt        DateTime?

  equipment     Equipment              @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  scores        EquipmentDNAScore[]
  evidence      EquipmentEvidence[]
  fits          EquipmentFitProfile[]
  personalities EquipmentPersonality[]

  @@index([equipmentId])
  @@index([status])
  @@map("equipment_dna_profiles")
}

model EquipmentDNAScore {
  id               String          @id @default(uuid()) @db.Uuid
  dnaProfileId     String          @db.Uuid
  characteristicId String          @db.Uuid
  score            Decimal         @db.Decimal(5, 2)
  confidence       ConfidenceLevel
  rationale        String?
  evidenceLevel    EvidenceLevel
  createdAt        DateTime        @default(now())

  dnaProfile     EquipmentDNAProfile     @relation(fields: [dnaProfileId], references: [id], onDelete: Cascade)
  characteristic EquipmentCharacteristic @relation(fields: [characteristicId], references: [id], onDelete: Cascade)
  evidence       EquipmentEvidence[]

  @@unique([dnaProfileId, characteristicId])
  @@index([dnaProfileId])
  @@index([characteristicId])
  @@map("equipment_dna_scores")
}

model EquipmentSpecification {
  id                String    @id @default(uuid()) @db.Uuid
  equipmentId       String    @db.Uuid
  specificationCode String
  valueText         String?
  valueNumber       Decimal?  @db.Decimal(12, 4)
  unit              String?
  source            String?
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@unique([equipmentId, specificationCode])
  @@index([equipmentId])
  @@index([specificationCode])
  @@index([verifiedAt])
  @@map("equipment_specifications")
}

model EquipmentEvidence {
  id              String              @id @default(uuid()) @db.Uuid
  equipmentId     String              @db.Uuid
  dnaProfileId    String?             @db.Uuid
  dnaScoreId      String?             @db.Uuid
  evidenceType    EvidenceType
  title           String
  summary         String
  sourceReference String?
  reliability     EvidenceReliability
  status          EvidenceStatus      @default(collected)
  collectedAt     DateTime?
  reviewedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  equipment  Equipment            @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  dnaProfile EquipmentDNAProfile? @relation(fields: [dnaProfileId], references: [id], onDelete: SetNull)
  dnaScore   EquipmentDNAScore?   @relation(fields: [dnaScoreId], references: [id], onDelete: SetNull)

  @@index([equipmentId])
  @@index([dnaProfileId])
  @@index([dnaScoreId])
  @@index([evidenceType])
  @@index([reliability])
  @@index([status])
  @@index([collectedAt])
  @@map("equipment_evidence")
}

model EquipmentFitProfile {
  id           String           @id @default(uuid()) @db.Uuid
  equipmentId  String           @db.Uuid
  dnaProfileId String           @db.Uuid
  fitType      EquipmentFitType
  fitCode      String
  strength     Int
  confidence   ConfidenceLevel
  rationale    String
  version      Int              @default(1)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  equipment  Equipment           @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  dnaProfile EquipmentDNAProfile @relation(fields: [dnaProfileId], references: [id], onDelete: Cascade)

  @@unique([dnaProfileId, fitType, fitCode, version])
  @@index([equipmentId])
  @@index([dnaProfileId])
  @@index([fitType])
  @@index([fitCode])
  @@index([confidence])
  @@map("equipment_fit_profiles")
}

model EquipmentPersonality {
  id                String          @id @default(uuid()) @db.Uuid
  equipmentId       String          @db.Uuid
  dnaProfileId      String          @db.Uuid
  personalityCode   String
  personalityName   String
  isPrimary         Boolean         @default(false)
  confidence        ConfidenceLevel
  derivationVersion String
  rationale         String
  createdAt         DateTime        @default(now())

  equipment  Equipment           @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  dnaProfile EquipmentDNAProfile @relation(fields: [dnaProfileId], references: [id], onDelete: Cascade)

  @@unique([dnaProfileId, personalityCode, derivationVersion])
  @@index([equipmentId])
  @@index([dnaProfileId])
  @@index([personalityCode])
  @@index([isPrimary])
  @@index([confidence])
  @@map("equipment_personalities")
}

model EquipmentComparison {
  id                 String               @id @default(uuid()) @db.Uuid
  sourceEquipmentId  String               @db.Uuid
  targetEquipmentId  String               @db.Uuid
  similarityScore    Decimal              @db.Decimal(5, 4)
  sharedStrengths    Json
  primaryDifferences Json
  sourceBestFor      String?
  targetBestFor      String?
  confidence         ComparisonConfidence
  version            Int                  @default(1)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  sourceEquipment Equipment @relation("SourceEquipmentComparison", fields: [sourceEquipmentId], references: [id], onDelete: Cascade)
  targetEquipment Equipment @relation("TargetEquipmentComparison", fields: [targetEquipmentId], references: [id], onDelete: Cascade)

  @@unique([sourceEquipmentId, targetEquipmentId, version])
  @@index([sourceEquipmentId])
  @@index([targetEquipmentId])
  @@index([similarityScore])
  @@index([confidence])
  @@map("equipment_comparisons")
}

model EquipmentDNAEvidenceRecord {
  id                         String                           @id @default(uuid()) @db.Uuid
  equipmentId                String?                          @db.Uuid
  equipmentVariantId         String?                          @db.Uuid
  targetLevel                EquipmentDNATargetLevel
  attributeKey               String
  attributeDefinitionVersion String
  sourceType                 EquipmentDNAEvidenceSourceType
  sourceName                 String
  sourceReference            String?
  sourceDate                 DateTime?
  retrievedAt                DateTime?
  method                     EquipmentEvaluationMethod
  rawValue                   Json?
  normalizedValue            Json?
  unit                       String?
  notes                      String?
  status                     EquipmentDNAEvidenceRecordStatus @default(active)
  evaluatorType              EquipmentDNAEvaluatorType?
  evaluatorReference         String?
  createdAt                  DateTime                         @default(now())
  updatedAt                  DateTime                         @updatedAt

  equipment        Equipment?                                @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  equipmentVariant EquipmentVariant?                         @relation(fields: [equipmentVariantId], references: [id], onDelete: Cascade)
  evaluationLinks  EquipmentDNAAttributeEvaluationEvidence[]

  @@index([equipmentId])
  @@index([equipmentVariantId])
  @@index([targetLevel])
  @@index([attributeKey])
  @@index([attributeDefinitionVersion])
  @@index([sourceType])
  @@index([status])
  @@index([createdAt])
  @@map("equipment_dna_evidence_records")
}

enum ExternalEvidenceSourceType {
  manufacturer_primary
  certification_authority
  official_product_documentation
  retailer
  independent_expert_review
  structured_testing_publication
  user_review
  community_discussion
  ninery_internal_measurement
  ninery_internal_evaluation
  ninery_controlled_test
  ninery_structured_field_observation
  derived_model_output
}

enum ExternalEvidenceClaimType {
  factual_specification
  subjective_observation
  comparative_observation
  marketing_claim
  field_observation
  measurement_observation
  test_observation
  modeled_output
  certification_claim
  identity_claim
}

enum ExternalEvidenceVerificationState {
  unverified_extracted
  source_confirmed
  corroborated
  conflicting
  review_required
  superseded
}

enum ExternalEvidenceReviewState {
  not_reviewed
  review_not_required
  review_pending
  reviewed_accepted
  reviewed_with_limitations
  reviewed_rejected
}

enum ExternalEvidenceDependencyType {
  original
  syndicated_from
  derived_from
  copied_from
  shared_upstream
  independent_observation
  unknown_dependency
}

enum ExternalEvidenceIdentityCertainty {
  exact_variant_match
  equipment_model_match
  family_only
  ambiguous
  conflicting
  unresolved
}

enum ExternalEvidenceConstructRole {
  direct_construct_evidence
  supporting_context
  calibration_evidence
  not_applicable
  candidate_only
}

enum ExternalEvidenceMappingMethod {
  manual_review
  controlled_vocabulary
  policy_mapping
  keyword_candidate
}

enum ExternalEvidenceQualificationState {
  qualified
  context_only
  review_required
  not_eligible
}

enum ExternalEvidenceReviewerType {
  human
  ai
  system
}

enum ExternalEvidenceConflictResolutionOutcome {
  resolved_no_material_conflict
  resolved_claim_superseded
  resolved_with_limitations
  unresolved
}

enum ExternalEvidenceIdentityScope {
  equipment_family
  certification_family
  drop_family
  size_family
  exact_variant
}

// Acquisition-layer records for external supporting evidence. These records are
// deliberately separate from EquipmentDNAEvidenceRecord and canonical evaluations.
model ExternalEvidenceSource {
  id                String                     @id @default(uuid()) @db.Uuid
  stableKey         String                     @unique
  displayName       String
  sourceType        ExternalEvidenceSourceType
  publisherIdentity String?
  operatorIdentity  String?
  state             String                     @default("active")
  sourceVersion     String
  metadata          Json?
  createdAt         DateTime                   @default(now())

  documents           ExternalEvidenceDocument[]
  governanceRevisions ExternalEvidenceSourceGovernanceRevision[]

  @@index([sourceType])
  @@index([state])
  @@map("external_evidence_sources")
}

model ExternalEvidenceSourceGovernanceRevision {
  id                   String                       @id @default(uuid()) @db.Uuid
  sourceId             String                       @db.Uuid
  revisionNumber       Int
  governanceVersion    String
  sourceType           ExternalEvidenceSourceType
  publisherIdentity    String?
  authorityScope       Json
  dependencyKnowledge  Json
  state                String
  reviewerType         ExternalEvidenceReviewerType
  reviewerReference    String
  rationale            String
  effectiveAt          DateTime
  supersedesRevisionId String?                      @unique @db.Uuid
  idempotencyKey       String                       @unique
  createdAt            DateTime                     @default(now())

  source                 ExternalEvidenceSource                     @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  supersedesRevision     ExternalEvidenceSourceGovernanceRevision?  @relation("ExternalSourceGovernanceSupersession", fields: [supersedesRevisionId, sourceId], references: [id, sourceId], onDelete: Restrict)
  supersededBy           ExternalEvidenceSourceGovernanceRevision[] @relation("ExternalSourceGovernanceSupersession")
  qualificationDecisions ExternalEvidenceQualificationDecision[]

  @@unique([sourceId, revisionNumber])
  @@unique([id, sourceId])
  @@index([sourceId, effectiveAt])
  @@index([sourceType, state])
  @@map("external_evidence_source_governance_revisions")
}

model ExternalEvidenceDocument {
  id                   String    @id @default(uuid()) @db.Uuid
  sourceId             String    @db.Uuid
  documentType         String
  sourceReference      String
  title                String
  publishedAt          DateTime?
  retrievedAt          DateTime
  modelYear            Int?
  revision             String    @default("unversioned")
  contentFingerprint   String?
  availability         String
  upstreamDocumentId   String?   @db.Uuid
  supersedesDocumentId String?   @db.Uuid
  createdAt            DateTime  @default(now())

  source              ExternalEvidenceSource     @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  upstreamDocument    ExternalEvidenceDocument?  @relation("ExternalDocumentUpstream", fields: [upstreamDocumentId], references: [id], onDelete: Restrict)
  downstreamDocuments ExternalEvidenceDocument[] @relation("ExternalDocumentUpstream")
  supersedesDocument  ExternalEvidenceDocument?  @relation("ExternalDocumentSupersession", fields: [supersedesDocumentId], references: [id], onDelete: Restrict)
  supersededBy        ExternalEvidenceDocument[] @relation("ExternalDocumentSupersession")
  claims              ExternalEvidenceClaim[]

  @@unique([sourceId, sourceReference, revision])
  @@index([sourceId])
  @@index([contentFingerprint])
  @@index([supersedesDocumentId])
  @@map("external_evidence_documents")
}

model ExternalEvidenceExtractionRun {
  id               String                      @id @default(uuid()) @db.Uuid
  method           String
  extractorType    String
  extractorId      String
  extractorVersion String
  executedAt       DateTime
  schemaVersion    String
  reviewState      ExternalEvidenceReviewState
  createdAt        DateTime                    @default(now())

  claims ExternalEvidenceClaim[]

  @@index([method])
  @@index([reviewState])
  @@map("external_evidence_extraction_runs")
}

model ExternalEvidenceIdentityAssertion {
  id                    String                            @id @default(uuid()) @db.Uuid
  certainty             ExternalEvidenceIdentityCertainty
  manufacturer          String?
  model                 String?
  modelYear             Int?
  certification         String?
  constructionRevision  String?
  lengthInches          Decimal?                          @db.Decimal(5, 2)
  weightOunces          Decimal?                          @db.Decimal(5, 2)
  drop                  Int?
  sku                   String?
  manufacturerProductId String?
  upc                   String?
  equipmentId           String?                           @db.Uuid
  equipmentVariantId    String?                           @db.Uuid
  limitations           Json
  createdAt             DateTime                          @default(now())

  equipment        Equipment?              @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  equipmentVariant EquipmentVariant?       @relation(fields: [equipmentVariantId], references: [id], onDelete: Restrict)
  claims           ExternalEvidenceClaim[]

  @@index([certainty])
  @@index([equipmentId])
  @@index([equipmentVariantId])
  @@index([manufacturer, model, modelYear])
  @@map("external_evidence_identity_assertions")
}

model ExternalEvidenceClaim {
  id                  String                            @id @default(uuid()) @db.Uuid
  documentId          String                            @db.Uuid
  identityAssertionId String                            @db.Uuid
  extractionRunId     String                            @db.Uuid
  sourceLocation      String?
  claimSlotKey        String?
  rawText             String?
  rawStructuredValue  Json?
  claimType           ExternalEvidenceClaimType
  verificationState   ExternalEvidenceVerificationState
  reviewState         ExternalEvidenceReviewState
  authority           String
  authorityRationale  String
  limitations         Json
  supersedesClaimId   String?                           @db.Uuid
  createdAt           DateTime                          @default(now())

  document              ExternalEvidenceDocument               @relation(fields: [documentId], references: [id], onDelete: Restrict)
  identityAssertion     ExternalEvidenceIdentityAssertion      @relation(fields: [identityAssertionId], references: [id], onDelete: Restrict)
  extractionRun         ExternalEvidenceExtractionRun          @relation(fields: [extractionRunId], references: [id], onDelete: Restrict)
