  status           DecisionBookStatus @default(draft)
  webUrl           String?
  pdfUrl           String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  recommendation Recommendation        @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  player         Player                @relation(fields: [playerId], references: [id], onDelete: Cascade)
  sections       DecisionBookSection[]

  @@index([recommendationId])
  @@index([playerId])
  @@index([status])
  @@map("decision_books")
}

model DecisionBookSection {
  id             String                  @id @default(uuid()) @db.Uuid
  decisionBookId String                  @db.Uuid
  sectionType    DecisionBookSectionType
  title          String
  content        Json
  sortOrder      Int                     @default(0)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  decisionBook DecisionBook @relation(fields: [decisionBookId], references: [id], onDelete: Cascade)

  @@index([decisionBookId])
  @@index([sortOrder])
  @@map("decision_book_sections")
}

model PlayerTimelineEvent {
  id                String                  @id @default(uuid()) @db.Uuid
  playerId          String                  @db.Uuid
  eventType         PlayerTimelineEventType
  title             String
  description       String?
  eventDate         DateTime
  relatedEntityType String?
  relatedEntityId   String?                 @db.Uuid
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([eventType])
  @@index([eventDate])
  @@index([relatedEntityType])
  @@map("player_timeline_events")
}

model PlatformEvent {
  id         String            @id @default(uuid()) @db.Uuid
  eventType  PlatformEventType
  entityType String
  entityId   String?           @db.Uuid
  payload    Json?
  createdAt  DateTime          @default(now())

  @@index([eventType])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@map("platform_events")
}

model ReferenceData {
  id          String            @id @default(uuid()) @db.Uuid
  type        ReferenceDataType
  code        String
  name        String
  description String?
  sortOrder   Int               @default(0)
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([type, code])
  @@index([type])
  @@index([active])
  @@map("reference_data")
}
